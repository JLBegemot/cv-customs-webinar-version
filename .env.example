# JWT secret — REQUIRED, at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# JWT access token lifetime in hours (default: 4)
JWT_EXPIRE_HOURS=4

# Deployment environment: dev | staging | prod | test
ENVIRONMENT=dev

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/cv_customs

# --- S3 / MinIO object storage ------------------------------------------------
# Leave S3_ENDPOINT_URL empty to target real AWS S3 (uses default endpoint).
# In dev it points at the `minio` service in docker-compose.yml.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cv-customs-dev
S3_REGION=us-east-1

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Data retention (days)
DATA_RETENTION_SOFT_DELETED_DAYS=30
DATA_RETENTION_INACTIVE_ACCOUNT_DAYS=365

# --- App base URL ------------------------------------------------------------
# Absolute origin used to build password-reset links in outbound email.
APP_BASE_URL=http://localhost:8000

# --- Email / Yandex Cloud Postbox --------------------------------------------
# Used for transactional email (password reset). Leave
# YC_POSTBOX_ACCESS_KEY_ID blank to route emails to the stdout logger
# (NullEmailClient) — local work doesn't need real delivery.
YC_POSTBOX_ACCESS_KEY_ID=
YC_POSTBOX_SECRET_ACCESS_KEY=
YC_POSTBOX_REGION=ru-central1
YC_POSTBOX_ENDPOINT_URL=https://postbox.cloud.yandex.net
FROM_EMAIL=no-reply@cv-customs.local
FROM_NAME=CV Customs

# Password-reset token lifetime (minutes).
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- MFA feature flag --------------------------------------------------------
# When false, /mfa/* endpoints return 404.
FEATURE_MFA=false

# --- Resume uploads ----------------------------------------------------------
# Hard cap on the multipart body for POST /api/v1/resumes/upload (bytes).
RESUME_UPLOAD_MAX_BYTES=5242880
